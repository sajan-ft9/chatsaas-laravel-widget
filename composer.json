{
    "name": "chatsaas/laravel-widget",
    "description": "Identity handshake, service-auth middleware, and widget embed for integrating the Chatsaas in-app assistant into any Laravel application.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Chatsaas\\LaravelWidget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chatsaas\\LaravelWidget\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chatsaas\\LaravelWidget\\ChatsaasServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
